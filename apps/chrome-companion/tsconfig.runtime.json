{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../..",
    "noEmitOnError": true,
    "noEmit": false
  },
  "include": [
    "background/**/*.ts",
    "hh/**/*.ts",
    "shared/**/*.ts",
    "popup/controller.ts"
  ]
}
