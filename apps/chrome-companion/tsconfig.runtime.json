{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome"],
    "strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true, "rootDir": ".", "noEmitOnError": true
  },
  "include": ["background/**/*.ts", "hh/**/*.ts", "shared/**/*.ts", "popup/controller.ts"]
}
