{
  "name": "budetoffer-chrome-companion",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --config eslint.companion.config.ts --max-warnings 0 apps scripts tests vitest.config.ts eslint.companion.config.ts",
    "check:runtime": "tsc -p apps/chrome-companion/tsconfig.runtime.json --noEmit",
    "check:popup": "tsc -p apps/chrome-companion/tsconfig.json --noEmit",
    "check:node": "tsc -p tsconfig.node.json --noEmit",
    "check:tests": "tsc -p tsconfig.tests.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check": "npm run check:runtime && npm run check:popup && npm run check:node && npm run check:tests && npm run check:boundaries",
    "test:node": "node --test tests/chairs-companion-*.test.ts",
    "test:ui": "vitest run --config vitest.config.ts",
    "test": "npm run test:node && npm run test:ui",
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "@qrko/shared": "file:vendor/qrko-shared",
    "@qrko/uikit": "file:vendor/qrko-uikit",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "25.9.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "neostandard": "0.14.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
